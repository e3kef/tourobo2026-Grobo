        <mxCell id="vJew-iT3ezXqCYUKen5m-17" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CAN&lt;/h1&gt;&lt;p&gt;Data: int16t[4]&lt;/p&gt;&lt;p&gt;※ DRIVE_TARGET受信が一定時間（例：100ms）途絶した場合、&lt;br&gt;xiaoは目標値を0としてモータを停止する&lt;/p&gt;&lt;p&gt;【CAN ID】&lt;/p&gt;&lt;blockquote&gt;0x001: SYSTEM_STOP&lt;br&gt;0x100: DRIVE_TARGET&lt;br&gt;0x101: D_MOTOR1_PARAM&lt;br&gt;0x102: D_MOTOR2_PARAM&lt;br&gt;0x103: D_MOTOR3_PARAM&lt;br&gt;0x104: D_MOTOR4_PARAM&lt;br&gt;0x200: GET_TARGET&lt;br&gt;0x201: GET_MOTOR1_PARAM&lt;br&gt;0x202: GET_MOTOR2_PARAM&lt;br&gt;0x300: GET_AIR_TARGET&lt;br&gt;0x400: SHOOT_TARGET&lt;br&gt;0x401: SHOOT_MOTOR1_PARAM&lt;br&gt;0x402: SHOOT_MOTOR2_PARAM&lt;br&gt;0x500: LIFT_TARGET&lt;br&gt;0x501: LIFT_MOTOR1_PARAM&lt;/blockquote&gt;&lt;p&gt;【足回りモーター指示値送信の場合】&lt;/p&gt;&lt;blockquote&gt;0: D_MOTOR1_TARGET&lt;br&gt;1: D_MOTOR2_TARGET&lt;br&gt;2: D_MOTOR3_TARGET&lt;br&gt;3: D_MOTOR4_TARGET&lt;/blockquote&gt;&lt;p&gt;【取得機構モーター指示値送信の場合】&lt;/p&gt;&lt;blockquote&gt;0: GET_MOTOR1_TARGET&lt;br&gt;1: GET_MOTOR2_TARGET&lt;br&gt;2: N/A&lt;br&gt;3: N/A&lt;br&gt;&lt;br&gt;&lt;/blockquote&gt;&lt;p&gt;【射出機構モーター指示値送信の場合】&lt;/p&gt;&lt;blockquote&gt;0: SHOOT_MOTOR1_TARGET&lt;br&gt;1: SHOOT_MOTOR2_TARGET&lt;br&gt;2: N/A&lt;br&gt;3: N/A&lt;/blockquote&gt;&lt;p&gt;【PIDゲイン設定の場合】&lt;/p&gt;&lt;blockquote&gt;0: mode(設定するゲインの選択)&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;0x001: P &lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;0x002: I&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0x003: D&lt;br&gt;&lt;/span&gt;&lt;/span&gt;1: 指示値(*1000した値を送信, 受信側でfloatに戻す)&lt;br&gt;2: N/A&lt;br&gt;3: N/A&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="800" width="364" x="320" y="1300" as="geometry" />
        </mxCell>
