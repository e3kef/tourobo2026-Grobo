        <mxCell id="vJew-iT3ezXqCYUKen5m-17" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CAN&lt;/h1&gt;&lt;p&gt;Data: int16t[4]&lt;/p&gt;&lt;p&gt;※ DRIVE_TARGET受信が一定時間（例：100ms）途絶した場合、&lt;br&gt;xiaoは目標値を0としてモータを停止する&lt;/p&gt;&lt;p&gt;【CAN ID】&lt;/p&gt;&lt;blockquote&gt;0x001: SYSTEM_STOP&lt;br&gt;0x002: MODE_SETTING&lt;br&gt;0x100: DRIVE_TARGET&lt;br&gt;0x101: D_MOTOR1_PARAM&lt;br&gt;0x102: D_MOTOR2_PARAM&lt;br&gt;0x103: D_MOTOR3_PARAM&lt;br&gt;0x104: D_MOTOR4_PARAM&lt;br&gt;0x200: GET_TARGET&lt;br&gt;0x201: GET_MOTOR1_PARAM&lt;br&gt;0x202: GET_MOTOR2_PARAM&lt;br&gt;0x300: GET_AIR_TARGET&lt;br&gt;0x400: SHOOT_TARGET&lt;br&gt;0x401: SHOOT_MOTOR1_PARAM&lt;br&gt;0x402: SHOOT_MOTOR2_PARAM&lt;br&gt;0x500: LIFT_TARGET&lt;br&gt;0x501: LIFT_MOTOR1_PARAM&lt;br&gt;0x601: DRIVE_PARAM_BACK_PID&lt;br&gt;0x602: GET_PARAM_BACK_PID&lt;br&gt;0x612: GET_PARAM_BACK_TARGET&lt;br&gt;0x604: SHOOT_PARAM_BACK_PID&lt;br&gt;0x605: LIFT_PARAM_BACK_PID&lt;br&gt;0x615: LIFT_PARAM_BACK_TARGET&lt;br&gt;&lt;/blockquote&gt;&lt;p&gt;【モード設定の場合】&lt;/p&gt;&lt;blockquote&gt;0: mode&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;0x001: nomal&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0x002: test&lt;br&gt;&lt;/span&gt;1~3: N/A&lt;/blockquote&gt;&lt;p&gt;【足回りモーター指示値送信の場合】&lt;/p&gt;&lt;blockquote&gt;0: D_MOTOR1_TARGET&lt;br&gt;1: D_MOTOR2_TARGET&lt;br&gt;2: D_MOTOR3_TARGET&lt;br&gt;3: D_MOTOR4_TARGET&lt;/blockquote&gt;&lt;p&gt;【取得機構モーター指示値送信の場合】&lt;/p&gt;&lt;blockquote&gt;0: GET_MOTOR1_TARGET&lt;br&gt;1: GET_MOTOR2_TARGET&lt;br&gt;2~3: N/A&lt;br&gt;&lt;br&gt;&lt;/blockquote&gt;&lt;p&gt;【射出機構モーター指示値送信の場合】&lt;/p&gt;&lt;blockquote&gt;0: SHOOT_MOTOR1_TARGET&lt;br&gt;1: SHOOT_MOTOR2_TARGET&lt;br&gt;2~3: N/A&lt;/blockquote&gt;&lt;p&gt;【PIDゲイン設定の場合】&lt;/p&gt;&lt;blockquote&gt;0: mode(設定するゲインの選択)&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;0x001: P &lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;0x002: I&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0x003: D&lt;br&gt;&lt;/span&gt;&lt;/span&gt;1: 指示値(*1000した値を送信, 受信側でfloatに戻す)&lt;br&gt;2~3: N/A&lt;/blockquote&gt;&lt;p&gt;【BACKの場合】&lt;/p&gt;&lt;blockquote&gt;0: motor(設定するモーターの選択 0x001~0x004)&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; or TARGET&lt;br&gt;&lt;/span&gt;&lt;/span&gt;1: Pゲイン or TARGET&lt;br&gt;2: Iゲイン or N/A&lt;br&gt;3: Dゲイン or N/A&lt;br&gt;&lt;br&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="1070" width="442.02" x="320" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="UQ-SNAUSBgdDSWdTdga4-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;【ファイル構成】&lt;/h1&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="54" y="3550" as="geometry" />
